<Window
    x:Class="EngineDA.Views.KBCalculatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="K/B 计算器"
    Width="400"
    Height="330"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Padding="15"
        Background="White"
        BorderBrush="#DDD"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Opacity="0.3"
                ShadowDepth="0"
                Color="Gray" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="采集最小值:" />
            <TextBox
                x:Name="txtXMin"
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,4"
                Padding="4"
                Background="#F0F0F0"
                BorderBrush="#CCC"
                BorderThickness="1" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="采集最大值:" />
            <TextBox
                x:Name="txtXMax"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,4"
                Padding="4"
                Background="#F0F0F0"
                BorderBrush="#CCC"
                BorderThickness="1" />

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="传感器量程最小值:" />
            <TextBox
                x:Name="txtYMin"
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,4"
                Padding="4"
                Background="#F0F0F0"
                BorderBrush="#CCC"
                BorderThickness="1" />

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="传感器量程最大值:" />
            <TextBox
                x:Name="txtYMax"
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,4"
                Padding="4"
                Background="#F0F0F0"
                BorderBrush="#CCC"
                BorderThickness="1" />

            <StackPanel
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Margin="0,15,0,0"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="计算结果:" />

                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="50"
                        VerticalAlignment="Center"
                        Text="K = " />
                    <TextBox
                        x:Name="txtK"
                        Width="200"
                        Padding="4"
                        Background="#E3F2FD"
                        BorderBrush="#90CAF9"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Foreground="#0D47A1"
                        IsReadOnly="True" />
                </StackPanel>

                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="50"
                        VerticalAlignment="Center"
                        Text="B = " />
                    <TextBox
                        x:Name="txtB"
                        Width="200"
                        Padding="4"
                        Background="#E3F2FD"
                        BorderBrush="#90CAF9"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Foreground="#0D47A1"
                        IsReadOnly="True" />
                </StackPanel>

                <!--  按钮区域  -->
                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,10,0"
                        Padding="4"
                        Background="#1976D2"
                        BorderThickness="0"
                        Click="BtnCalculate_Click"
                        Content="计算"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        Width="80"
                        Padding="4"
                        Background="#B0BEC5"
                        BorderThickness="0"
                        Click="BtnClose_Click"
                        Content="关闭"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="Black" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
