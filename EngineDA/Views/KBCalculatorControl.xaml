<Window
    x:Class="EngineDA.Views.KBCalculatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="K/B 计算器"
    Width="450"
    Height="500"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Margin="0,0,0,-100"
        Background="#1E1E24"
        BorderBrush="#33333C"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.5"
                ShadowDepth="0"
                Color="Black" />
        </Border.Effect>

        <Grid Margin="0,0,0,-1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#25252D"
                CornerRadius="10,10,0,0"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#E0E0E0"
                        Text="🧮 传感器 K/B 校准计算器" />
                    <Button
                        Width="40"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnClose_Click"
                        Content="✕"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D32F2F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="25,20,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#B0B0B0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#1A1A1F" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="#33333C" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,6" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Grid.Resources>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="通道量程最小值 (X - 电压/电流):" />
                <TextBox
                    x:Name="txtXMin"
                    Grid.Row="0"
                    Grid.Column="1"
                    ToolTip="例如：4mA 或 1V" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="通道量程最大值 (X - 电压/电流):" />
                <TextBox
                    x:Name="txtXMax"
                    Grid.Row="1"
                    Grid.Column="1"
                    ToolTip="例如：20mA 或 5V" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="传感器量程最小值 (Y - 物理量):" />
                <TextBox
                    x:Name="txtYMin"
                    Grid.Row="2"
                    Grid.Column="1"
                    ToolTip="例如：0 MPa" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="传感器量程最大值 (Y - 物理量):" />
                <TextBox
                    x:Name="txtYMax"
                    Grid.Row="3"
                    Grid.Column="1"
                    ToolTip="例如：10 MPa" />

                <StackPanel
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,20,0,0"
                    Orientation="Vertical">
                    <Border
                        Height="1"
                        Margin="0,0,0,15"
                        Background="#33333C" />

                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="计算结果 (精度无损):" />

                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock
                            Width="40"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#00E676"
                            Text="K = " />
                        <TextBox
                            x:Name="txtK"
                            Width="350"
                            Background="#2A2A35"
                            BorderBrush="#00E676"
                            FontWeight="Bold"
                            Foreground="#00E676"
                            IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <TextBlock
                            Width="40"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#007ACC"
                            Text="B = " />
                        <TextBox
                            x:Name="txtB"
                            Width="350"
                            Background="#2A2A35"
                            BorderBrush="#007ACC"
                            FontWeight="Bold"
                            Foreground="#007ACC"
                            IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="90"
                            Height="35"
                            Margin="0,0,15,0"
                            Background="#007ACC"
                            BorderThickness="0"
                            Click="BtnCalculate_Click"
                            Content="开始计算"
                            Cursor="Hand"
                            FontWeight="Bold"
                            Foreground="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            Width="90"
                            Height="35"
                            Background="#444444"
                            BorderThickness="0"
                            Click="BtnClose_Click"
                            Content="取消"
                            Cursor="Hand"
                            Foreground="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>