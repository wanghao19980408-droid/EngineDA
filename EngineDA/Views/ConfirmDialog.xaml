<Window
    x:Class="EngineDA.Views.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="350"
    Height="120"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Grid>
        <Border
            x:Name="BlurOverlay"
            Background="#80000000"
            CornerRadius="0" />

        <Border
            Width="350"
            Height="120"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="0"
                    Opacity="0.3"
                    ShadowDepth="0"
                    Color="Gray" />
            </Border.Effect>
            <StackPanel>
                <TextBlock
                    x:Name="MessageTextBlock"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#333"
                    Text="提示信息"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="10,0"
                        Background="#1E90FF"
                        Click="ConfirmButton_Click"
                        Content="确认"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        Width="80"
                        Margin="10,0"
                        Background="#E0E0E0"
                        Click="CancelButton_Click"
                        Content="取消"
                        FontWeight="Bold"
                        Foreground="#333" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
