<Window
    x:Class="EngineDA.Views.FilterConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="历史数据滤波配置"
    Width="400"
    Height="320"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Background="#1E1E24"
        BorderBrush="#33333C"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.5"
                ShadowDepth="0"
                Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#25252D"
                CornerRadius="10,10,0,0"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#00E676"
                        Text="⚙️ 实验数据滤波配置" />
                    <Button
                        Width="40"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnClose_Click"
                        Content="✕"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="White" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="25">
                <TextBlock
                    Margin="0,0,0,15"
                    FontSize="13"
                    Foreground="#B0B0B0"
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="chkEnableFilter"
                    Margin="0,0,0,20"
                    Content="开启实验数据自动滤波"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="White" />

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="窗口采样总数 (N): " />
                    <TextBox
                        x:Name="txtWindowSize"
                        Grid.Column="1"
                        Padding="5"
                        Background="#1A1A1F"
                        BorderBrush="#33333C"
                        Foreground="White"
                        Text="10"
                        TextAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="前后剔除个数 (M): " />
                    <TextBox
                        x:Name="txtTrimCount"
                        Grid.Column="1"
                        Padding="5"
                        Background="#1A1A1F"
                        BorderBrush="#33333C"
                        Foreground="White"
                        Text="2"
                        TextAlignment="Center" />
                </Grid>

                <Button
                    Height="38"
                    Background="#007ACC"
                    BorderThickness="0"
                    Click="BtnSave_Click"
                    Content="💾 保存配置"
                    Cursor="Hand"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>