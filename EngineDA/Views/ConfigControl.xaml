<UserControl
    x:Class="EngineDA.Views.ConfigControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EngineDA.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Margin="10" Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <TabControl
            Grid.Row="0"
            ItemsSource="{Binding Sheets}"
            SelectedIndex="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Padding="8,4"
                        FontWeight="Bold"
                        Text="{Binding SheetName}" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DataGrid
                        AlternatingRowBackground="#F7F9FC"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        FontFamily="Segoe UI"
                        FontSize="16"
                        FontWeight="Bold"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="#E0E0E0"
                        ItemsSource="{Binding SensorConfigs}"
                        RowBackground="White"
                        RowHeight="40"
                        SelectedItem="{Binding DataContext.SelectedSensorConfig, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        VerticalGridLinesBrush="#E0E0E0">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="Black" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="Black" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Name}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="1*"
                                Binding="{Binding Channel}"
                                Header="Channel" />
                            <DataGridTextColumn
                                Width="1*"
                                Binding="{Binding K}"
                                Header="K" />
                            <DataGridTextColumn
                                Width="1*"
                                Binding="{Binding B}"
                                Header="B" />
                            <DataGridTextColumn
                                Width="1*"
                                Binding="{Binding Unit}"
                                Header="Unit" />
                            <DataGridTextColumn
                                Width="1*"
                                Binding="{Binding Min}"
                                Header="Min" />
                            <DataGridTextColumn
                                Width="1*"
                                Binding="{Binding Max}"
                                Header="Max" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Button
            Grid.Row="1"
            Width="150"
            Height="35"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#1E90FF"
            BorderThickness="0"
            Command="{Binding SaveAndRestartCommand}"
            Content="保存"
            Cursor="Hand"
            FontWeight="Bold"
            Foreground="White">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
