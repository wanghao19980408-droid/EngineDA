<Window
    x:Class="EngineDA.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="寰宇航天 - 数据采集引擎"
    Width="1400"
    Height="800"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Background="#1E1E24"
        BorderBrush="#33333C"
        BorderThickness="1"
        CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#25252D"
                CornerRadius="10,10,0,0"
                MouseLeftButtonDown="Border_MouseLeftButtonDown"
                MouseLeftButtonUp="Border_MouseLeftButtonUp"
                MouseMove="Border_MouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="20,0,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="36"
                            Height="36"
                            Margin="0,0,15,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ToggleSidebar_Click"
                            Content="☰"
                            Cursor="Hand"
                            FontSize="20"
                            Foreground="#E0E0E0"
                            ToolTip="收起/展开菜单">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter
                                                        Margin="0,-2,0,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#444444" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Image
                            Height="40"
                            Source="/Assets/Images/logo.png"
                            Stretch="Uniform" />
                        <TextBlock
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#E0E0E0"
                            Text="寰宇航天 | 发动机采集系统" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,30,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="12"
                            Height="12"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="{Binding ConnectionStatusColor}" />
                        <TextBlock
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="White"
                            Text="{Binding ConnectionStatusText}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="40"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Minimize_Click"
                            Content="—"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#444444" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            Width="40"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Maximize_Click"
                            Content="☐"
                            Cursor="Hand"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter
                                                        Margin="0,0,0,2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#444444" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            Width="40"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Close_Click"
                            Content="✕"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D32F2F" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="SidebarBorder"
                    Grid.Column="0"
                    Width="200"
                    Background="#1A1A1F"
                    BorderBrush="#33333C"
                    BorderThickness="0,1,1,0"
                    ClipToBounds="True"
                    CornerRadius="0,0,0,10">
                    <StackPanel
                        Width="200"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#B0B0B0" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="Height" Value="50" />
                                <Setter Property="Margin" Value="10,0,10,10" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border
                                                x:Name="border"
                                                Background="Transparent"
                                                CornerRadius="5">
                                                <ContentPresenter
                                                    Margin="20,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A2A35" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#007ACC" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#B0B0B0" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="Margin" Value="10,0,10,10" />
                                <Setter Property="Background" Value="#25252D" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A3A45" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock
                            Margin="20,0,0,10"
                            FontSize="12"
                            Foreground="#666"
                            Text="数据监控" />
                        <RadioButton
                            Checked="NavRadioButton_Checked"
                            Content="实时数据"
                            IsChecked="True" />
                        <RadioButton Checked="NavRadioButton_Checked" Content="实时曲线" />
                        <RadioButton
                            Checked="NavRadioButton_Checked"
                            Content="历史数据"
                            Visibility="Hidden" />

                        <TextBlock
                            Margin="20,15,0,10"
                            FontSize="12"
                            Foreground="#666"
                            Text="系统配置" />
                        <RadioButton Checked="NavRadioButton_Checked" Content="配置文件" />

                        <TextBlock
                            Margin="20,15,0,10"
                            FontSize="12"
                            Foreground="#666"
                            Text="工具箱" />
                        <Button Click="OpenKBCalculator_Click" Content="K/B 计算器" />
                        <Button Click="OpenComm_Click" Content="通信配置" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="15"
                    Padding="10"
                    Background="#25252D"
                    CornerRadius="8">
                    <Grid x:Name="MainContentGrid">
                        <Grid x:Name="TrendsPageGrid" Visibility="Collapsed">
                            <DockPanel Margin="8" LastChildFill="True">
                                <StackPanel
                                    Margin="0,0,0,8"
                                    DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="120"
                                        Height="32"
                                        Background="#007ACC"
                                        BorderThickness="0"
                                        Click="AddTrendControl_Click"
                                        Content="添加趋势图"
                                        Cursor="Hand"
                                        Foreground="White">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel
                                        x:Name="TrendsContainer"
                                        Margin="8"
                                        Orientation="Horizontal" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>