<Window
    x:Class="EngineDA.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EngineDA"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="发动机采集系统"
    Width="2200"
    Height="1170"
    AllowsTransparency="True"
    Background="{x:Null}"
    FontSize="12"
    FontWeight="ExtraLight"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Styles/DefaultStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Border
        Margin="5"
        Background="White"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="8"
                Direction="0"
                Opacity="0.3"
                ShadowDepth="0"
                Color="Gray" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="160" />
                <RowDefinition />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                CornerRadius="10,10,0,0"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#0D47A1" />
                        <GradientStop Offset="1" Color="#1976D2" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="20,10,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Image
                            Width="Auto"
                            Height="70"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Assets/Images/logo.png"
                            Stretch="Uniform" />
                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <TextBlock
                                FontFamily="Segoe UI Variable Semibold"
                                FontSize="42"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="寰宇航天" />
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="18"
                                Foreground="#CCFFFFFF"
                                Text="发动机采集系统" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="30,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#33000000"
                        CornerRadius="8">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                FontSize="28"
                                Foreground="#FFD700"
                                Text="⏱" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Courier New, Monospace"
                                FontSize="48"
                                FontWeight="Bold"
                                Foreground="#FFD700"
                                Text="{Binding ProcessDurationText}">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Opacity="0.6"
                                        ShadowDepth="0"
                                        Color="#FFD700" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <Button
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ResetTimerCommand}"
                                Content="↺"
                                Cursor="Hand"
                                FontSize="26"
                                FontWeight="Bold"
                                Foreground="#FFD700"
                                ToolTip="重置计时">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.RenderTransform>
                                    <ScaleTransform CenterX="0.5" CenterY="0.5" />
                                </Button.RenderTransform>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <Button
                            Margin="2,0"
                            Click="Minimize_Click"
                            Style="{StaticResource MinButtonStyle}" />
                        <Button
                            Margin="2,0"
                            Click="Maximize_Click"
                            Style="{StaticResource MaxButtonStyle}" />
                        <Button
                            Margin="2,0"
                            Click="Close_Click"
                            Style="{StaticResource CloseButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <RadioButton
                            Margin="0,0,20,0"
                            Checked="NavRadioButton_Checked"
                            Content="实时数据"
                            GroupName="Nav"
                            Style="{StaticResource NavRadioButtonStyle}" />
                        <RadioButton
                            Margin="0,0,20,0"
                            Checked="NavRadioButton_Checked"
                            Content="实时曲线"
                            GroupName="Nav"
                            Style="{StaticResource NavRadioButtonStyle}" />
                        <RadioButton
                            Checked="NavRadioButton_Checked"
                            Content="配置文件"
                            GroupName="Nav"
                            Style="{StaticResource NavRadioButtonStyle}" />
                        <RadioButton
                            Margin="0,0,20,0"
                            Checked="NavRadioButton_Checked"
                            Content="历史数据"
                            GroupName="Nav"
                            Style="{StaticResource NavRadioButtonStyle}"
                            Visibility="Hidden" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        Click="OpenKBCalculator_Click"
                        Content="K/B 计算器"
                        FontWeight="Bold"
                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        Click="OpenComm_Click"
                        Content="通信配置"
                        FontWeight="Bold"
                        Style="{StaticResource ButtonPrimary}" />
                </Grid>

                <Grid x:Name="MainContentGrid" Grid.Row="1">

                    <Grid x:Name="TrendsPageGrid" Visibility="Collapsed">
                        <DockPanel Margin="8" LastChildFill="True">
                            <StackPanel
                                Margin="0,0,0,8"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal">
                                <Button
                                    Width="120"
                                    Height="32"
                                    Click="AddTrendControl_Click"
                                    Content="添加趋势图" />
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <WrapPanel
                                    x:Name="TrendsContainer"
                                    Margin="8"
                                    Orientation="Horizontal" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                </Grid>
            </Grid>

            <Border
                Grid.Row="2"
                Padding="5,0"
                CornerRadius="0,0,10,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#0D47A1" />
                        <GradientStop Offset="1" Color="#1976D2" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel LastChildFill="True">
                    <StackPanel
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            Fill="{Binding ConnectionStatusColor}"
                            Stroke="White"
                            StrokeThickness="1" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding ConnectionStatusText}" />
                    </StackPanel>

                    <TextBlock
                        Margin="20,0,10,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding CurrentTime}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>