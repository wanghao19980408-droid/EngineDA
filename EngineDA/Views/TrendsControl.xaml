<UserControl
    x:Class="EngineDA.Views.TrendsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Background="#1E1E24"
    FontFamily="Microsoft YaHei, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#25252D"
            BorderBrush="#33333C"
            BorderThickness="0,0,0,1">
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="选择传感器:" />

                <ComboBox
                    x:Name="CmbSensors"
                    Width="160"
                    Height="30"
                    VerticalAlignment="Center"
                    MaxDropDownHeight="300"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="2,0,6,0"
                                    FontWeight="Bold"
                                    Foreground="#A0A0A0"
                                    Text="{Binding DisplayChannel}" />
                                <TextBlock
                                    Margin="2,0"
                                    Background="Transparent"
                                    Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>

                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="5,4" />
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border
                                            x:Name="Bd"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFD9EBFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF007ACC" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <Button
                    x:Name="BtnChangeColor"
                    Width="30"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="Lime"
                    Click="BtnChangeColor_Click"
                    Cursor="Hand"
                    ToolTip="点击更换颜色" />

                <TextBlock
                    Margin="15,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="目标视图:" />
                <ComboBox
                    x:Name="CmbTargetPlot"
                    Width="80"
                    Height="30"
                    VerticalAlignment="Center"
                    SelectedIndex="0">
                    <ComboBoxItem Content="图表 1" />
                    <ComboBoxItem Content="图表 2" />
                    <ComboBoxItem Content="图表 3" />
                    <ComboBoxItem Content="图表 4" />
                </ComboBox>

                <Button
                    x:Name="BtnAdd"
                    Width="80"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="#007ACC"
                    BorderThickness="0"
                    Click="BtnAdd_Click"
                    Content="➕ 添加"
                    Cursor="Hand"
                    Foreground="White" />

                <Separator
                    Width="1"
                    Margin="15,10"
                    Background="#33333C" />

                <Button
                    x:Name="BtnAutoY"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Background="DarkOliveGreen"
                    BorderThickness="0"
                    Click="BtnAutoY_Click"
                    Content="✅ 自适应Y轴"
                    Cursor="Hand"
                    Foreground="White" />
                <Button
                    x:Name="BtnFreeze"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Background="DarkOrange"
                    BorderThickness="0"
                    Click="BtnFreeze_Click"
                    Content="⏸ 画面冻结"
                    Cursor="Hand"
                    Foreground="Black" />
                <Button
                    x:Name="BtnClear"
                    Width="80"
                    Height="30"
                    Margin="0,0,10,0"
                    Background="DarkRed"
                    BorderThickness="0"
                    Click="BtnClear_Click"
                    Content="🗑 清屏"
                    Cursor="Hand"
                    Foreground="White" />

                <Button
                    x:Name="BtnSaveLayout"
                    Width="90"
                    Height="30"
                    Margin="0,0,10,0"
                    Background="#007ACC"
                    BorderThickness="0"
                    Click="BtnSaveLayout_Click"
                    Content="💾 保存布局"
                    Cursor="Hand"
                    Foreground="White" />
                <Button
                    x:Name="BtnLoadLayout"
                    Width="90"
                    Height="30"
                    Margin="0,0,10,0"
                    Background="#444444"
                    BorderThickness="0"
                    Click="BtnLoadLayout_Click"
                    Content="📂 加载布局"
                    Cursor="Hand"
                    Foreground="White" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#1A1A1F">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="6"
                    Background="#25252D"
                    BorderBrush="#33333C"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="12,0"
                            Background="#2A2A35"
                            CornerRadius="5,5,0,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="📈" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#A0A0A0"
                                    Text="实时波形监控 - 区域 1" />
                            </StackPanel>
                        </Border>
                        <ScottPlot:WpfPlot
                            x:Name="WpfPlot1"
                            Grid.Row="1"
                            Margin="4"
                            RenderOptions.BitmapScalingMode="LowQuality" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="6"
                    Background="#25252D"
                    BorderBrush="#33333C"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="12,0"
                            Background="#2A2A35"
                            CornerRadius="5,5,0,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="📈" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#A0A0A0"
                                    Text="实时波形监控 - 区域 2" />
                            </StackPanel>
                        </Border>
                        <ScottPlot:WpfPlot
                            x:Name="WpfPlot2"
                            Grid.Row="1"
                            Margin="4"
                            RenderOptions.BitmapScalingMode="LowQuality" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="6"
                    Background="#25252D"
                    BorderBrush="#33333C"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="12,0"
                            Background="#2A2A35"
                            CornerRadius="5,5,0,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="📈" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#A0A0A0"
                                    Text="实时波形监控 - 区域 3" />
                            </StackPanel>
                        </Border>
                        <ScottPlot:WpfPlot
                            x:Name="WpfPlot3"
                            Grid.Row="1"
                            Margin="4"
                            RenderOptions.BitmapScalingMode="LowQuality" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="6"
                    Background="#25252D"
                    BorderBrush="#33333C"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="12,0"
                            Background="#2A2A35"
                            CornerRadius="5,5,0,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="📈" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#A0A0A0"
                                    Text="实时波形监控 - 区域 4" />
                            </StackPanel>
                        </Border>
                        <ScottPlot:WpfPlot
                            x:Name="WpfPlot4"
                            Grid.Row="1"
                            Margin="4"
                            RenderOptions.BitmapScalingMode="LowQuality" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Background="#1A1A1F"
                BorderBrush="#33333C"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,20,0,15"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="实时通道监控" />

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="InfoPanel"
                            Margin="10,0,10,10"
                            Orientation="Vertical" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>