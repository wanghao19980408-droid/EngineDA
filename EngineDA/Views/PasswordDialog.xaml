<Window
    x:Class="EngineDA.Views.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="安全验证"
    Width="320"
    Height="200"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Background="#1E1E24"
        BorderBrush="#33333C"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.5"
                ShadowDepth="0"
                Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#25252D"
                CornerRadius="10,10,0,0"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#E0E0E0"
                    Text="🔒 请输入访问密码" />
            </Border>

            <StackPanel Grid.Row="1" Margin="25,20,25,15">
                <PasswordBox
                    x:Name="pwdBox"
                    Height="35"
                    Padding="8,5"
                    Background="#1A1A1F"
                    BorderBrush="#33333C"
                    FontSize="16"
                    Foreground="White" />
                <TextBlock
                    x:Name="txtError"
                    Margin="0,5,0,0"
                    FontSize="12"
                    Foreground="#FF3B30"
                    Text="密码错误，请重试！"
                    Visibility="Collapsed" />

                <StackPanel
                    Margin="0,15,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="#007ACC"
                        BorderThickness="0"
                        Click="BtnConfirm_Click"
                        Content="确认"
                        Cursor="Hand"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button
                        Width="80"
                        Height="32"
                        Background="#444444"
                        BorderThickness="0"
                        Click="BtnCancel_Click"
                        Content="取消"
                        Cursor="Hand"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>