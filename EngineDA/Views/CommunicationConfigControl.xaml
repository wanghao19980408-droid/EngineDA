<Window
    x:Class="EngineDA.Views.CommunicationConfigControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="通信配置"
    Width="432"
    Height="560"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Background="#1E1E24"
        BorderBrush="#33333C"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.5"
                ShadowDepth="0"
                Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  顶部标题栏  -->
            <Border
                Grid.Row="0"
                Background="#25252D"
                CornerRadius="10,10,0,0"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#E0E0E0"
                        Text="📡 工控机网络通信配置" />
                    <Button
                        Width="40"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnCancel_Click"
                        Content="✕"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D32F2F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!--  主内容区  -->
            <StackPanel Grid.Row="1" Margin="25,20,25,20">

                <!--  统一样式定义  -->
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#B0B0B0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#1A1A1F" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="#33333C" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="8,8" />
                        <Setter Property="Margin" Value="0,8" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="#E0E0E0" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </StackPanel.Resources>

                <!--  工控机1 配置卡片  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="#25252D"
                    CornerRadius="8">
                    <StackPanel>
                        <!--  启用勾选框  -->
                        <CheckBox
                            x:Name="chkEnableIpc1"
                            Content="启用 工控机1 通信"
                            IsChecked="True" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="组播地址:" />
                            <TextBox
                                x:Name="txtIpc1IP"
                                Grid.Row="0"
                                Grid.Column="1"
                                IsEnabled="{Binding IsChecked, ElementName=chkEnableIpc1}"
                                ToolTip="工控机1的组播地址" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="端口号:" />
                            <TextBox
                                x:Name="txtIpc1Port"
                                Grid.Row="1"
                                Grid.Column="1"
                                IsEnabled="{Binding IsChecked, ElementName=chkEnableIpc1}"
                                ToolTip="工控机1通信端口" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  工控机2 配置卡片  -->
                <Border
                    Margin="0,0,0,20"
                    Padding="15"
                    Background="#25252D"
                    CornerRadius="8">
                    <StackPanel>
                        <!--  启用勾选框  -->
                        <CheckBox
                            x:Name="chkEnableIpc2"
                            Content="启用 工控机2 通信"
                            IsChecked="False" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="组播地址:" />
                            <TextBox
                                x:Name="txtIpc2IP"
                                Grid.Row="0"
                                Grid.Column="1"
                                IsEnabled="{Binding IsChecked, ElementName=chkEnableIpc2}"
                                ToolTip="工控机2的组播地址" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="端口号:" />
                            <TextBox
                                x:Name="txtIpc2Port"
                                Grid.Row="1"
                                Grid.Column="1"
                                IsEnabled="{Binding IsChecked, ElementName=chkEnableIpc2}"
                                ToolTip="工控机2通信端口" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  底部按钮区  -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="btnSave"
                        Width="90"
                        Height="36"
                        Margin="0,0,15,0"
                        Background="#007ACC"
                        BorderThickness="0"
                        Click="BtnSave_Click"
                        Content="保存配置"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        x:Name="btnCancel"
                        Width="90"
                        Height="36"
                        Background="#444444"
                        BorderThickness="0"
                        Click="BtnCancel_Click"
                        Content="取消"
                        Cursor="Hand"
                        Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>