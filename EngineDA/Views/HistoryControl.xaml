<UserControl
    x:Class="EngineDA.Views.HistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="0,0,15,0"
            Padding="15"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="8"
            Effect="{DynamicResource EffectShadow2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="实验数据解析" />

                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,15"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThirdTextBrush}"
                        Text="起始时间 (秒): " />
                    <TextBox
                        x:Name="TxtStartTime"
                        Width="60"
                        Padding="0,4"
                        hc:InfoElement.Placeholder="-10"
                        Text="-10"
                        TextAlignment="Center"
                        TextChanged="TxtStartTime_TextChanged" />
                </StackPanel>

                <Button
                    Grid.Row="2"
                    Height="36"
                    Margin="0,0,0,15"
                    hc:BorderElement.CornerRadius="4"
                    Click="LoadDatFiles_Click"
                    Content="加载原始数据"
                    Style="{StaticResource ButtonPrimary}" />

                <Border
                    Grid.Row="3"
                    Margin="0,0,0,15"
                    Padding="12"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="4">
                    <TextBlock
                        x:Name="TxtStatus"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        LineHeight="20"
                        Text="正在加载系统配置..."
                        TextWrapping="Wrap" />
                </Border>

                <hc:Divider
                    Grid.Row="4"
                    Margin="0,0,0,10"
                    VerticalAlignment="Top"
                    Content="选择传感器 (可多选)" />

                <ListBox
                    x:Name="SensorListBox"
                    Grid.Row="4"
                    Margin="0,35,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="SensorListBox_SelectionChanged"
                    SelectionMode="Multiple">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="Bd"
                                            Margin="0,2"
                                            Padding="10,6"
                                            Background="Transparent"
                                            CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#15888888" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#10B981" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TxtName"
                                    Width="120"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    x:Name="TxtCh"
                                    Width="65"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource ThirdTextBrush}"
                                    Text="{Binding Channel, StringFormat='[CH:{0}]'}" />
                                <TextBlock
                                    x:Name="TxtUnit"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="{Binding Unit}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="TxtName" Property="Foreground" Value="White" />
                                    <Setter TargetName="TxtCh" Property="Foreground" Value="#E5E5E5" />
                                    <Setter TargetName="TxtUnit" Property="Foreground" Value="White" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border
                    Grid.Row="5"
                    Margin="0,15,0,0"
                    Padding="12"
                    Background="#1E1E1E"
                    CornerRadius="6">
                    <TextBlock
                        x:Name="TxtCursorData"
                        FontSize="13"
                        Foreground="#00E676"
                        LineHeight="22"
                        Text="查看各通道详细数值"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="8"
            Effect="{DynamicResource EffectShadow2}">
            <ScottPlot:WpfPlot
                x:Name="HistoryPlot"
                Margin="5"
                SnapsToDevicePixels="True"
                TextOptions.TextFormattingMode="Display"
                UseLayoutRounding="True" />
        </Border>
    </Grid>
</UserControl>