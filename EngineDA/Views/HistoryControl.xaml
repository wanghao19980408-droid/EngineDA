<UserControl
    x:Class="EngineDA.Views.HistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid
        Margin="15"
        Background="Transparent"
        Focusable="True"
        PreviewKeyDown="Grid_PreviewKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="0,0,15,0"
            Padding="15"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="8"
            Effect="{DynamicResource EffectShadow2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="实验数据解析" />

                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,15"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThirdTextBrush}"
                        Text="起始时间 (秒): " />
                    <TextBox
                        x:Name="TxtStartTime"
                        Width="60"
                        Padding="0,4"
                        hc:InfoElement.Placeholder="-10"
                        Text="-10"
                        TextAlignment="Center"
                        TextChanged="TxtStartTime_TextChanged" />
                </StackPanel>

                <Button
                    Grid.Row="2"
                    Height="36"
                    Margin="0,0,0,15"
                    hc:BorderElement.CornerRadius="4"
                    Click="LoadDatFiles_Click"
                    Content="加载原始数据"
                    Style="{StaticResource ButtonPrimary}" />

                <Border
                    Grid.Row="3"
                    Margin="0,0,0,15"
                    Padding="12"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            x:Name="TxtStatus"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            LineHeight="20"
                            Text="正在加载系统配置..."
                            TextWrapping="Wrap" />
                        <ProgressBar
                            x:Name="ParseProgressBar"
                            Height="20"
                            Margin="0,8,0,0"
                            Background="#1A1A1F"
                            BorderThickness="0"
                            Foreground="#007ACC"
                            Maximum="100"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <hc:Divider
                    Grid.Row="4"
                    Margin="0,0,0,10"
                    VerticalAlignment="Top"
                    Content="选择传感器 (可多选)" />

                <ListBox
                    x:Name="SensorListBox"
                    Grid.Row="5"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="SensorListBox_SelectionChanged"
                    SelectionMode="Multiple">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="Bd"
                                            Margin="0,2"
                                            Padding="10,6"
                                            Background="Transparent"
                                            CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#15888888" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#10B981" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TxtName"
                                    Width="120"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    x:Name="TxtCh"
                                    Width="65"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource ThirdTextBrush}"
                                    Text="{Binding Channel, StringFormat='[CH:{0}]'}" />
                                <TextBlock
                                    x:Name="TxtUnit"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="{Binding Unit}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="TxtName" Property="Foreground" Value="White" />
                                    <Setter TargetName="TxtCh" Property="Foreground" Value="#E5E5E5" />
                                    <Setter TargetName="TxtUnit" Property="Foreground" Value="White" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <hc:Divider
                    Grid.Row="6"
                    Margin="0,15,0,10"
                    Content="游标处数据 (支持键盘左右键)"
                    Foreground="#A0A0A0" />

                <ScrollViewer
                    Grid.Row="7"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CursorDataList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="12,10"
                                    Background="#25252D"
                                    BorderBrush="#33333C"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="12"
                                                Foreground="#888"
                                                Text="{Binding ChannelInfo}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding Value}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="8"
            Effect="{DynamicResource EffectShadow2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScottPlot:WpfPlot
                    x:Name="HistoryPlot"
                    Grid.Row="0"
                    Margin="5"
                    SnapsToDevicePixels="True"
                    TextOptions.TextFormattingMode="Display"
                    UseLayoutRounding="True" />

                <Border
                    Grid.Row="1"
                    Padding="15,10,15,15"
                    Background="#1A1A1F"
                    BorderBrush="#33333C"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                    <StackPanel>
                        <TextBlock
                            x:Name="TxtSliderTime"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#00E676"
                            Text="当前时刻: -- 秒" />

                        <Slider
                            x:Name="TimeSlider"
                            Cursor="Hand"
                            IsSnapToTickEnabled="False"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="TimeSlider_ValueChanged"
                            Value="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>