<UserControl
    x:Class="EngineDA.Views.RealTimeDataControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    Background="#1E1E24"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="10,10,10,5"
            Padding="15,10"
            Background="#25252D"
            CornerRadius="8">
            <DockPanel>
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#888"
                        Text="🔍" />
                    <TextBox
                        Width="180"
                        Padding="8,5"
                        Background="#1A1A1F"
                        BorderBrush="#33333C"
                        BorderThickness="1"
                        CaretBrush="White"
                        Foreground="White"
                        SnapsToDevicePixels="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="20,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#FFD700"
                        Text="📺 大屏缩放:" />
                    <Slider
                        x:Name="ZoomSlider"
                        Width="120"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        IsSnapToTickEnabled="True"
                        Maximum="3.0"
                        Minimum="0.8"
                        TickFrequency="0.1"
                        Value="0.8" />
                    <TextBlock
                        Width="35"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#00E676"
                        Text="{Binding Value, ElementName=ZoomSlider, StringFormat={}{0:F1}x}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Margin="5"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl
                ItemsSource="{Binding FilteredSensorsView}"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="4,15,4,5"
                                    Padding="15,8"
                                    Background="#25252D"
                                    BorderBrush="#33333C"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Border.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}" ScaleY="{Binding Value, ElementName=ZoomSlider}" />
                                    </Border.LayoutTransform>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#007ACC"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#888"
                                            Text="{Binding ItemCount, StringFormat=' ({0} 项)'}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>

                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ItemsPresenter />
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel
                            Margin="0"
                            Orientation="Horizontal"
                            SpacingMode="None"
                            StretchItems="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="{Binding CardWidth}"
                            Height="{Binding CardHeight}"
                            Margin="4"
                            BorderThickness="2"
                            CornerRadius="8">

                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}" ScaleY="{Binding Value, ElementName=ZoomSlider}" />
                            </Border.LayoutTransform>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#18181E" />
                                    <Setter Property="BorderBrush" Value="{Binding Color, TargetNullValue=#333340, FallbackValue=#333340}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF3B30" />
                                            <Setter Property="Background" Value="#2A1515" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" CornerRadius="5,5,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{Binding Color, TargetNullValue=#1E90FF, FallbackValue=#1E90FF}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                                                    <Setter Property="Background" Value="#FF3B30" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <DockPanel Margin="12,0">
                                        <ToggleButton
                                            Margin="5,-2,-5,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            DockPanel.Dock="Right"
                                            IsChecked="{Binding IsImportant}"
                                            ToolTip="设为重要监测点">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="☆" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Setter Property="FontSize" Value="22" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="{TemplateBinding FontSize}"
                                                                    Foreground="{TemplateBinding Foreground}"
                                                                    Text="{TemplateBinding Content}" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="⭐" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>

                                <Viewbox
                                    Grid.Row="1"
                                    Margin="15,10,15,15"
                                    Stretch="Uniform"
                                    StretchDirection="DownOnly">

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <TextBlock
                                            FontSize="55"
                                            FontWeight="Black"
                                            Text="{Binding DisplayValue}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#00E676" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF3B30" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock
                                            Margin="10,0,0,12"
                                            VerticalAlignment="Bottom"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="#A0A0A0"
                                            Text="{Binding Unit}" />
                                    </StackPanel>
                                </Viewbox>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="10,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#666"
                                    Text="{Binding Channel, StringFormat='CH{0}'}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>